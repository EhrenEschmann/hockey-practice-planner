rules_version = '2';
// Authorization for the team-centric layout (docs/data-model.md). The app's redirects are a convenience; these rules are the guarantee.
//
//   teams/{teamId}                              { id, name, club, admins: [emails] }        admins write; members read
//   teams/{teamId}/members/{email}              { role: 'coach' | 'family', name, playerIds } the lookup every rule below makes
//   teams/{teamId}/players/{playerId}           { name, contacts: [emails] }
//   teams/{teamId}/practices/{pid}              the HEADER: { kind, date, time, stage, open, sharedWith, sharedTeam, drillNames … }
//   teams/{teamId}/practices/{pid}/plan/body    the drills (heavy) — same readers as the header
//   …/practices/{pid}/clips|videos/{id}         recorded intros / voice-overs, video chunks — same readers
//   …/practices/{pid}/views/{id}                audit log: viewers append in their own name; admins read
//   …/practices/{pid}/feedback/{uid_drill}      a coach's note: the author and admins
//   teams/{teamId}/tasks/{week}                 the week's task list (Sunday-keyed)
//   teams/{teamId}/stats/{playerId_week}        a player's numbers: their family or a coach writes; coaches read all, a family its own
//   teams/{teamId}/media/{id}                   a task's how-to audio / video chunks
//   practiceIndex/{pid}                         { teamId } — lets an older link that named only the practice find its team
//   people/{email}                              { persona, teams: { [teamId]: { name, role, players } } } — that person's teams; them and the planner only
//   users/{uid}/meta/{doc}                      the planner's own working documents (the roster)
//   users/{uid}/private/{doc}                   the planner's secrets (the encrypted Claude key)
//   requests/{uid}, attempts/{uid}              access requests and sign-ins that got nowhere
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && 'email' in request.auth.token && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.token.email.lower(); }
    // The planner(s) can do anything — keep this list in step with OWNER_EMAILS in js/main.js. A team's admins can do anything in that team.
    function isPlanner() { return signedIn() && me() in ['ehren.eschmann@gmail.com']; }
    function teamPath(t) { return /databases/$(database)/documents/teams/$(t); }
    function memberPath(t) { return /databases/$(database)/documents/teams/$(t)/members/$(me()); }
    function isAdmin(t) { return isPlanner() || (signedIn() && exists(teamPath(t)) && me() in get(teamPath(t)).data.get('admins', [])); }
    function isMember(t) { return signedIn() && exists(memberPath(t)); }
    function isCoach(t) { return isMember(t) && get(memberPath(t)).data.role == 'coach'; }
    // May this person see a practice with this header? Coaches from its 'coaches' stage, everyone on the team once
    // 'team'; anyone signed in (a guest too) when it is marked open; and the extra emails named on the practice itself.
    function viewable(t, h) {
      return (h.stage == 'team' && isMember(t))
        || (h.stage == 'coaches' && isCoach(t))
        || (h.stage != 'draft' && h.get('open', false) == true && request.auth != null)
        || (signedIn() && h.stage != 'draft' && me() in h.get('sharedWith', []))
        || (signedIn() && h.stage == 'team' && me() in h.get('sharedTeam', []));
    }
    function headerPath(t, pid) { return /databases/$(database)/documents/teams/$(t)/practices/$(pid); }
    function canViewPractice(t, pid) { return isAdmin(t) || (exists(headerPath(t, pid)) && viewable(t, get(headerPath(t, pid)).data)); }
    function coachOfPractice(t, pid) { return isCoach(t) && exists(headerPath(t, pid)) && get(headerPath(t, pid)).data.stage != 'draft'; }

    // ---- teams
    match /teams/{teamId} {
      allow read: if isAdmin(teamId) || isMember(teamId);
      allow write: if isAdmin(teamId);
      match /members/{email} {
        allow read: if isAdmin(teamId) || (signedIn() && me() == email) || isCoach(teamId);
        allow write: if isAdmin(teamId);
      }
      match /players/{playerId} {
        allow read: if isAdmin(teamId) || isMember(teamId);
        allow write: if isAdmin(teamId);
      }
      // Headers: a list query must carry the stage filter the reader is entitled to, so the rules can prove it.
      match /practices/{pid} {
        allow read: if isAdmin(teamId) || viewable(teamId, resource.data);
        allow write: if isAdmin(teamId);
        match /plan/{doc} {
          allow read: if canViewPractice(teamId, pid);
          allow write: if isAdmin(teamId);
        }
        match /clips/{clipId} {
          allow read: if canViewPractice(teamId, pid);
          allow write: if isAdmin(teamId);
        }
        match /videos/{chunkId} {
          allow read: if canViewPractice(teamId, pid);
          allow write: if isAdmin(teamId);
        }
        match /views/{viewId} {
          allow create: if canViewPractice(teamId, pid) && request.resource.data.uid == request.auth.uid;
          allow read, delete: if isAdmin(teamId);
        }
        // One document per coach per drill: `${uid}_${drillId}` (or `${uid}_overall`). Coaches never see each other's.
        match /feedback/{fid} {
          function mine() {
            return request.resource.data.uid == request.auth.uid && request.resource.data.email == me()
              && fid.matches('^' + request.auth.uid + '_[A-Za-z0-9]+$')
              && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
          }
          allow create: if coachOfPractice(teamId, pid) && mine() && !('resolved' in request.resource.data);
          allow update: if isAdmin(teamId) || (coachOfPractice(teamId, pid) && resource.data.uid == request.auth.uid && mine()
            && request.resource.data.get('resolved', false) == false); // a rewritten note is unresolved again
          allow delete: if isAdmin(teamId) || (coachOfPractice(teamId, pid) && resource.data.uid == request.auth.uid);
          allow read: if isAdmin(teamId) || (coachOfPractice(teamId, pid) && resource.data.uid == request.auth.uid);
        }
      }
      // ---- official club teams: the week's tasks, each player's numbers, and a task's how-to media
      match /tasks/{week} {
        allow read: if isAdmin(teamId) || isMember(teamId);
        allow write: if isAdmin(teamId);
      }
      match /stats/{sid} {
        function playerPath(pid) { return /databases/$(database)/documents/teams/$(teamId)/players/$(pid); }
        function familyOf(pid) { return signedIn() && exists(playerPath(pid)) && me() in get(playerPath(pid)).data.get('contacts', []); }
        function wellFormed() {
          return request.resource.data.playerId is string && request.resource.data.week is string
            && sid == request.resource.data.playerId + '_' + request.resource.data.week
            && request.resource.data.values is map && request.resource.data.by == me();
        }
        allow read: if isAdmin(teamId) || isCoach(teamId) || familyOf(resource.data.playerId);
        allow create, update: if wellFormed() && (isAdmin(teamId) || isCoach(teamId) || familyOf(request.resource.data.playerId));
        allow delete: if isAdmin(teamId);
      }
      match /media/{mid} {
        allow read: if isAdmin(teamId) || isMember(teamId);
        allow write: if isAdmin(teamId);
      }
    }
    // The planner reads every coach's feedback across teams in one go.
    match /{path=**}/feedback/{fid} {
      allow read: if isPlanner();
    }

    // ---- lookups
    match /practiceIndex/{pid} {
      allow read: if request.auth != null; // only { teamId }: lets an older link find its team; the practice itself is still gated
      allow write: if isPlanner();
    }
    match /people/{email} {
      allow read: if isPlanner() || (signedIn() && me() == email);
      allow write: if isPlanner();
    }

    // ---- the planner's own account
    match /users/{uid}/meta/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isPlanner() && request.auth.uid == uid;
    }
    match /users/{uid}/private/{docId} {
      allow read, write: if isPlanner() && request.auth.uid == uid;
    }

    // ---- sign-ins that got nowhere: someone on no roster opened the app — one document per account, in their own
    //      name, so the planner can see who tried (and let them in). Nothing else is readable to them.
    match /attempts/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid && request.resource.data.email == me()
        && request.resource.data.name is string && request.resource.data.name.size() <= 200
        && request.resource.data.path is string && request.resource.data.path.size() <= 300;
      allow read, delete: if isPlanner();
    }
    // ---- "request access" from someone on no roster: one document per account, in their own name
    match /requests/{uid} {
      function ownRequest() {
        return signedIn() && request.auth.uid == uid
          && request.resource.data.uid == uid && request.resource.data.email == me()
          && request.resource.data.status == 'open' && request.resource.data.role in ['coach', 'team']
          && request.resource.data.note is string && request.resource.data.note.size() <= 300
          && request.resource.data.name is string && request.resource.data.name.size() <= 200;
      }
      allow create: if ownRequest();
      // Re-asking after a denial waits 7 days.
      allow update: if isPlanner() || (ownRequest() && (resource.data.status != 'denied'
        || request.time.toMillis() > resource.data.deniedAt + 604800000));
      allow read: if isPlanner() || (signedIn() && request.auth.uid == uid);
      allow delete: if isPlanner();
    }
  }
}
