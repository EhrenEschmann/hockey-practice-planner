rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can read and write their own practices.
    // A practice can also be *read* by anyone whose email the owner listed in its
    // `sharedWith` array (presentation mode / coach view).
    // Per-user metadata (team roster etc.) — owner only.
    match /users/{uid}/meta/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/practices/{practiceId} {
      allow write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        ('email' in request.auth.token &&
         request.auth.token.email.lower() in resource.data.get('sharedWith', []))
      );
    }
  }
}
