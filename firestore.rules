rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only the planner(s) can create or change anything — keep this list in step with OWNER_EMAILS in
    // js/main.js. Everyone else is a viewer: they sign in only so the rules can check their email.
    function isPlanner() {
      return request.auth != null && 'email' in request.auth.token &&
        request.auth.token.email.lower() in ['ehren.eschmann@gmail.com'];
    }
    // A planner can read and write their own practices.
    // A practice can also be *read* by anyone whose email the owner listed in its
    // `sharedWith` (coaches — full plan) or `sharedTeam` (players' families — no coaching
    // notes) array. Both views are read-only; only the owner can ever write.
    // Per-user metadata (team roster etc.) — owner only.
    match /users/{uid}/meta/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if isPlanner() && request.auth.uid == uid;
    }
    match /users/{uid}/practices/{practiceId} {
      allow write: if isPlanner() && request.auth.uid == uid;
      allow read: if request.auth != null && (
        request.auth.uid == uid ||
        ('email' in request.auth.token && (
          request.auth.token.email.lower() in resource.data.get('sharedWith', []) ||
          request.auth.token.email.lower() in resource.data.get('sharedTeam', [])
        ))
      );
      // Audit log: anyone who may read the practice can append a record of what they viewed or played,
      // in their own name only; just the owner can read (or clear) the log.
      match /views/{viewId} {
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && (
          request.auth.uid == uid ||
          ('email' in request.auth.token && (
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedWith', []) ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedTeam', [])
          ))
        );
        allow read, delete: if request.auth != null && request.auth.uid == uid;
      }
      // An uploaded drill video, stored in chunks: owner writes; readable by whoever may read the practice.
      match /videos/{chunkId} {
        allow write: if isPlanner() && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          ('email' in request.auth.token && (
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedWith', []) ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedTeam', [])
          ))
        );
      }
      // A drill's recorded intro clip: owner writes; readable by whoever may read the practice.
      match /clips/{drillId} {
        allow write: if isPlanner() && request.auth.uid == uid;
        allow read: if request.auth != null && (
          request.auth.uid == uid ||
          ('email' in request.auth.token && (
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedWith', []) ||
            request.auth.token.email.lower() in get(/databases/$(database)/documents/users/$(uid)/practices/$(practiceId)).data.get('sharedTeam', [])
          ))
        );
      }
    }
  }
}
